from sklearn.decomposition import PCA
from sklearn.manifold import TSNE

from keras.datasets import mnist

import numpy as np
import matplotlib.pyplot as plt

(xtrain, ytrain), (xtest, ytest) = mnist.load_data()
print("X Train")
print(xtrain)
print("X tEST")
print(xtest)
xtrain = np.reshape(xtrain, [-1, 28*28])
xtest = np.reshape(xtest, [-1, 28*28])
ytrain = np.reshape(ytrain, [-1,1])
ytest = np.reshape(ytest, [-1,1])
print("X Train")
print(xtrain)
print("X tEST")
print(xtest)
datax = np.vstack((xtrain, xtest))
datay = np.vstack((ytrain, ytest))
colors = ["red", "green", "blue", "springgreen","hotpink", "navy", "lightcoral", "purple","fuchsia","dodgerblue"] 
print("Data Train")
print(datax)

pca = PCA(30) # 784'den 30 boyuta indirge
reduc = pca.fit_transform(datax)

data = np.hstack((reduc, datay))
data = data[data[:,-1].argsort()] # sirala

data_count = 1000 # her sayi icin 1000 sample alinacak
viable_data = []
prev_c = 0
for i in range(10):
    c = np.sum(data[:,-1]==i)
    viable_data.append(data[prev_c:prev_c+data_count]) # 1000 veri al her sayi icin
    prev_c += c

viable_data = np.array(viable_data) # 10000x31'luk array
print(viable_data.shape)
viable_data = np.reshape(viable_data,[-1,31])
data_x = viable_data[:,:-1] # 10000x30
data_y = viable_data[:,-1] # 10000,
data_y = np.reshape(data_y, [-1,1]) # 10000x1

tsne = TSNE(2, n_iter=250,verbose=2) # iki boyuta indirge
viable_data_reduc = tsne.fit_transform(data_x)

data = np.hstack((viable_data_reduc, data_y))
print (data.shape) # 10000x3

for idx, color in enumerate(colors):
    plt.scatter(data[idx*data_count:(idx+1)*data_count,0],data[idx*data_count:(idx+1)*data_count,1], c=color,lw=0)
    
plt.legend(range(10))
plt.show()